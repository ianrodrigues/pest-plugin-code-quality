{
    "name": "ianrodrigues/pest-plugin-quality",
    "description": "Method-level maintainability limits (complexity, body lines, parameters) as Pest architecture expectations, with baselines for gradual adoption.",
    "type": "library",
    "keywords": [
        "pest",
        "pest-plugin",
        "architecture",
        "quality",
        "complexity",
        "static-analysis"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Ian Rodrigues",
            "email": "ianrdgs@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "pestphp/pest-plugin": "^5.0",
        "pestphp/pest-plugin-arch": "~5.0.0",
        "nikic/php-parser": "^5.6"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.2",
        "phpstan/phpstan": "^2.2",
        "symfony/yaml": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Pest\\Quality\\": "src/"
        },
        "files": [
            "src/Autoload.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "pest",
        "test:parallel": "pest --parallel",
        "lint": "pint src tests",
        "lint:check": "pint --test src tests",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "@lint:check",
            "@analyse",
            "@test"
        ],
        "post-install-cmd": "@hooks",
        "post-update-cmd": "@hooks",
        "hooks": "git rev-parse --is-inside-work-tree > /dev/null 2>&1 && git config core.hooksPath .githooks || true"
    }
}
