{
    "name": "rdgs/pest-plugin-quality-adoption-fixture",
    "description": "Throwaway project exercising pest-plugin-code-quality's baselines end to end.",
    "type": "project",
    "repositories": [
        {
            "type": "path",
            "url": "../../..",
            "options": {
                "symlink": false
            }
        }
    ],
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "ianrodrigues/pest-plugin-code-quality": "*",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-arch": "~5.0.0"
    },
    "autoload": {
        "psr-4": {
            "Fixture\\App\\": "app/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
