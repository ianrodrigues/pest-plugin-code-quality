#!/usr/bin/env sh
# Enforces Conventional Commits and forbids references to the task tracker in messages.
msg_file="$1"
subject=$(sed -n '1p' "$msg_file")
body=$(grep -vE '^(#|Co-Authored-By:|Claude-Session:)' "$msg_file")

if ! printf '%s\n' "$subject" | grep -qE '^(feat|fix|docs|test|chore|ci|refactor|perf|build|style|revert)(\([a-z0-9._/-]+\))?!?: [^ ].{0,71}$'; then
  echo "commit-msg: subject must be Conventional Commits, e.g. 'feat: add method lines expectation' (max 72 chars)" >&2
  echo "  got: $subject" >&2
  exit 1
fi
if printf '%s\n' "$subject" | grep -qE '[A-Z][a-z]+: ' ; then :; fi
if printf '%s\n' "$subject" | grep -qE ': [A-Z][a-z]' ; then
  echo "commit-msg: start the description in lower case" >&2
  exit 1
fi
if printf '%s\n' "$subject" | grep -qE '\.$'; then
  echo "commit-msg: no trailing period in the subject" >&2
  exit 1
fi
if printf '%s\n' "$body" | grep -qiE '\.tasks|\btasks?[ #-]?[0-9]{1,2}\b|[0-9]{2}-[a-z-]+\.md|\bPRD\b|product requirements document'; then
  echo "commit-msg: do not reference task numbers, task files or the requirements document; describe the change itself" >&2
  exit 1
fi
if [ -n "$(sed -n '2p' "$msg_file")" ]; then
  echo "commit-msg: leave the second line blank" >&2
  exit 1
fi
exit 0
